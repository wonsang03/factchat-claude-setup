# ==========================================================
#  키 발급 방법
#   1) https://engineering-mokpo-ac.factchat.bot 접속
#   2) 학교 포털 계정으로 로그인 (회원가입 필요 없음)
#   3) 좌측 하단 [API Gateway] - [+ API 키 생성]
#   4) 이름 입력 후 [생성하기] - 표시된 키를 복사
#      * 키는 다시 조회할 수 없으니 이 화면을 벗어나기 전에 복사할 것
#      * 크레딧은 본인 계정에서 차감되므로 키를 남과 공유하지 말 것
#
# ==========================================================

ANTHROPIC_AUTH_TOKEN=PUT-YOUR-KEY-HERE

# 모델: claude-haiku-4-5-20251001 (수업 기본, 크레딧 최소)
#       claude-sonnet-5           (무거운 작업)
#       claude-opus-5             (설계/어려운 오류, 크레딧 최대)

ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 접속 서버 주소 - 수업에서는 바꾸지 마세요.
ANTHROPIC_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway/claude
